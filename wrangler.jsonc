{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidechick",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "MATCH",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "Matchmaker"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://sidechicks.vercel.app"
  },
  "observability": {
    "enabled": false
  }
}